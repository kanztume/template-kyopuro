long long meguru_bisect(long long ok, long long ng) {
    while (std::abs(ok - ng) > 1) {
        long long mid = ok + (ng - ok) / 2; // オーバーフロー防止の記述
        if (is_ok(mid)) {
            ok = mid;
        } else {
            ng = mid;
        }
    }
    return ok;
}
